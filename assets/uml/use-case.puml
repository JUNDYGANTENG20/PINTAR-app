@startuml
' Kelompok 5 - Sistem Informasi PINTAR | APSI 3B-SI
title Use Case Diagram - Sistem Informasi PINTAR (revisi)
footer Kelompok 5 (APSI 3B-SI) | UC01-UC10 = punya Activity & Sequence Diagram
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #2F4156
skinparam actor {
  BorderColor #2F4156
  BackgroundColor #C8D9E6
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #567C8D
  BackgroundColor<<pendukung>> #F5EFEB
  BorderColor<<pendukung>> #B08F7A
}
skinparam rectangle {
  BackgroundColor #F7FAFC
  BorderColor #2F4156
}

actor Mahasiswa

rectangle "Sistem Informasi PINTAR" {
  ' --- Mahasiswa ---
  usecase "UC01 Melihat Beranda\n(FR-10, FR-12)" as UC01
  usecase "UC02 Menjelajahi dan\nMencari Kegiatan\n(FR-07, FR-08)" as UC02
  usecase "Memfilter Jenis Kegiatan\n(FR-09)" <<pendukung>> as F1
  usecase "Memfilter Kategori/Bidang\n(multi-pilih)\n(FR-13, FR-14)" <<pendukung>> as F2
  usecase "UC03 Melihat Detail\nKegiatan (FR-11)" as UC03
  usecase "Melihat Periode &\nStatus Pendaftaran (FR-04)" <<pendukung>> as D1
  usecase "Melihat Kontak\nPenyelenggara (FR-06)" <<pendukung>> as D2
  usecase "Melihat Sumber Resmi &\nStatus Verifikasi\n(FR-15, FR-16)" <<pendukung>> as D3
  usecase "Membuka Sumber Asli\n(FR-17)" <<pendukung>> as D4
  usecase "UC04 Melihat Informasi\nBeasiswa (FR-01, FR-03)" as UC04
  usecase "Melihat Persyaratan &\nKriteria (FR-02)" <<pendukung>> as B1
  usecase "UC05 Mengelola Pengingat\nDeadline (FR-05)" as UC05
  usecase "UC11 Registrasi Akun" as UC11
  usecase "UC12 Login" as UC12

  ' --- Admin ---
  usecase "UC06 Mengelola Data\nKegiatan" as UC06
  usecase "UC07 Menambahkan\nKegiatan" as UC07
  usecase "Mengunggah Poster" <<pendukung>> as P1
  usecase "UC08 Memperbarui\nKegiatan" as UC08
  usecase "UC09 Menghapus\nKegiatan" as UC09
  usecase "UC10 Memverifikasi\nInformasi Kegiatan (FR-16)" as UC10
}

actor "Admin/Pengelola" as Admin

Mahasiswa --> UC01
Mahasiswa --> UC02
Mahasiswa --> UC03
Mahasiswa --> UC04
Mahasiswa --> UC05
Mahasiswa --> UC11
Mahasiswa --> UC12

UC02 <.. F1 : <<extend>>
UC02 <.. F2 : <<extend>>
UC03 ..> D1 : <<include>>
UC03 ..> D2 : <<include>>
UC03 ..> D3 : <<include>>
UC03 <.. D4 : <<extend>>
UC04 ..> B1 : <<include>>
UC04 <.. D4 : <<extend>>
UC05 ..> UC12 : <<include>>

Admin --> UC06
Admin --> UC10
Admin --> UC12
UC06 <.. UC07 : <<extend>>
UC06 <.. UC08 : <<extend>>
UC06 <.. UC09 : <<extend>>
UC07 <.. P1 : <<extend>>
UC08 <.. P1 : <<extend>>
UC06 ..> UC12 : <<include>>
UC10 ..> UC12 : <<include>>
@enduml
